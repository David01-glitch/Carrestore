# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is git-ignored.
# ---------------------------------------------------------------------------

# REQUIRED for production. The public origin of the deployed site, with no
# trailing slash and no path. Canonical URLs, Open Graph tags, JSON-LD,
# robots.txt and sitemap.xml are all derived from it.
#
# The build refuses to produce a production bundle when this is missing,
# points at localhost, or uses a reserved example domain.
#
#   SITE_URL=https://www.example-real-domain.com
SITE_URL=

# OPTIONAL. Your own Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
#
# Leave empty and analytics stays completely switched off: no script is loaded,
# no cookies are set, and the cookie banner does not appear — there would be
# nothing to consent to. The privacy and cookie policies read from this value
# and describe the site's real behaviour either way.
#
# Only set this to a property you actually own or are authorised to use.
GA4_ID=

# OPTIONAL. Port for the bundled Express server (npm start). Defaults to 4173.
PORT=4173

# OPTIONAL. Set to "true" only when the site is served over HTTPS behind a proxy
# you control, to emit a Strict-Transport-Security header from Express.
# Not needed on Amplify, which sets it via customHttp.yml.
ENABLE_HSTS=false
