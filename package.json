{
  "name": "us-car-restoration",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "US Car Restoration — an independent editorial resource on American classic car restoration.",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:config && vite-react-ssg build && npm run postbuild",
    "postbuild": "node scripts/generate-sitemap.mjs && node scripts/generate-robots.mjs",
    "preview": "node server.js",
    "start": "node server.js",
    "check": "tsc --noEmit",
    "validate:config": "node scripts/validate-config.mjs",
    "validate:images": "node scripts/validate-images.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "fetch:images": "node scripts/fetch-images.mjs",
    "qa": "node scripts/qa.mjs",
    "verify": "npm run check && npm run validate:images && npm run validate:links && npm run qa"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-react-ssg": "^0.9.2"
  }
}
